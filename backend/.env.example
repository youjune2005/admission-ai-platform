# LLM 제공자: openai | anthropic | mock (키 없이 테스트하려면 mock)
LLM_PROVIDER=openai

# 실제 키는 backend/.env 에만 넣으세요. 이 파일에는 절대 넣지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 스캔 PDF에서 Paddle/CLOVA 결과가 빈약할 때만 쓰는 Vision OCR 모델
OPENAI_OCR_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 네이버 클라우드 CLOVA General OCR (선택)
# 콘솔 → CLOVA OCR → General 도메인 → API Gateway 연동 후 값 입력
# 미설정 시 Paddle 실패 후 바로 GPT Vision으로 폴백합니다.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
CLOVA_OCR_ENABLE_TABLE=true

# 로컬 OCR 엔진: rapidocr(ONNX Runtime, 기본) | paddle
OCR_LOCAL_ENGINE=rapidocr
# 페이지 동시 인식 수. 한 페이지가 이미 코어를 다 쓰므로 보통 1로 두세요.
OCR_WORKERS=1
# 아래 둘은 paddle 엔진에서만 사용
OCR_PADDLE_CPU_THREADS=10
# macOS 휠에는 oneDNN이 없어 켜면 엔진 초기화가 실패합니다(리눅스 배포에서만 true).
OCR_PADDLE_MKLDNN=false
# 180° 뒤집힌 줄 보정용. 스캔이 거꾸로 들어오는 일이 있으면 true 로 바꾸세요.
OCR_USE_ANGLE_CLS=false
# PDF→이미지 배율. 낮추면 빨라지지만 작은 글자 인식률이 떨어집니다.
OCR_RENDER_SCALE=2.0

# macOS 한컴오피스 한글 UI로 HWP→PDF (요금 없음, 접근성 권한 필요)
# 설정: ./scripts/setup_hancom_hwp_pdf.sh
# HWP_USE_HANCOM_UI=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

DATABASE_URL=sqlite:///./admission_ai.db
UPLOAD_DIR=./uploads

# 공유 터널 사용 시 (단기 데모)
# CORS_ALLOW_ALL=true
# RATE_LIMIT_PER_MINUTE=60

# 공유 터널 사용 시 프론트 공개 URL을 추가 (쉼표 구분) — CORS_ALLOW_ALL 미사용 시
# CORS_ORIGINS=["http://localhost:5173","https://xxxx.trycloudflare.com"]
